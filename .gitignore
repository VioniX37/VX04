# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime data (uploaded datasets, run workdirs, sqlite db)
backend/workspace/
evaluation_results/

# Env / secrets
.env
.env.*
!.env.example

# Node / Next.js (frontend has its own .gitignore too)
node_modules/
.next/
out/

# OS / editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Claude / Claude Code (any directory level)
.claude/
CLAUDE.md
CLAUDE.local.md
.mcp.json
AGENTS.md
# ...but not the documentation page (Windows matches ignore rules case-insensitively)
!docs/concepts/agents.md
# Datasets: only the small bundled samples and their generators are versioned.
# Large or third-party data (e.g. Kaggle downloads) must never be committed.
data/**
!data/samples/
!data/samples/*.py
!data/samples/customer_churn.csv
!data/samples/customer_churn_leaky.csv
!data/samples/house_prices.csv
!data/samples/product_reviews.csv
!data/samples/store_sales.csv
*.zip
*.parquet
backend/evaluation/data/

# Frontend side-by-side build directories
.next-*/
*.tsbuildinfo
backend/evaluation/data/

# Logs
*.log

# Built documentation site
site/

# LaTeX build outputs
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/main.pdf
