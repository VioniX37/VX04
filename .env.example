# Copy to backend/.env and fill in. Every setting is documented in docs/reference/configuration.md.

# ---- LLM (Gemini) ----
# gemini = real runs; fake = deterministic offline backend for tests/demos (no key needed)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Reasoning-heavy roles (Manager, Operation Agent) / high-volume roles (Prompt, Data, Model agents).
# Check the ids available to your key with: automl-agent models
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# Tried in order when a model is overloaded (503) or out of quota (429)
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash
# Free-tier friendly throttling (raise on a paid key)
GEMINI_RPM_SMART=5
GEMINI_RPM_FAST=15
GEMINI_MAX_CONCURRENCY=2
GEMINI_MAX_RETRIES=6
LLM_TEMPERATURE=0.2
LLM_CACHE=true
LLM_CACHE_NAMESPACE=default
# Merge Data+Model agent calls into one call per plan (fewer requests)
AGENT_FUSION=false
# Web knowledge via Gemini's Google Search tool
SEARCH_GROUNDING=true

# Vertex AI instead of AI Studio (optional)
GEMINI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# ---- Pipeline ----
N_PLANS=3
MAX_REVISIONS=2
MAX_DEBUG_ATTEMPTS=3
CODEGEN_MODE=llm
# grounded = successive halving on real data (default); pseudo = paper-faithful LLM-predicted ranking
VERIFICATION_MODE=grounded
GROUNDING_MIN_ROWS=20000
GROUNDING_GROWTH=4
GROUNDING_ETA=2
GROUNDING_VALID_ROWS=100000
# Experience memory
MEMORY_ENABLED=true
MEMORY_K=3
MEMORY_EXCLUDE_SAME_DATASET=false
# Budgets per run (0 = unlimited)
BUDGET_WALL_S=0
BUDGET_LLM_CALLS=0
BUDGET_TOKENS=0
# Training processes
EXEC_TIMEOUT_S=1800
EXEC_MAX_MEM_MB=0
EXEC_N_JOBS=-1

# ---- Data ----
MAX_UPLOAD_MB=5120
ALLOW_PATH_REGISTRATION=true

# ---- Server ----
CORS_ORIGINS=["http://localhost:3000"]

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
