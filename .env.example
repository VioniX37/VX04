# Copy to backend/.env and fill in. Full reference: docs/reference/configuration.md

# ---- LLM (Gemini) ----
# gemini = real runs; fake = deterministic offline backend for tests/demos (no key needed)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Reasoning-heavy roles (Manager, Operation Agent) / high-volume roles (Prompt, Data, Model agents)
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# Free-tier friendly throttling (raise these on a paid key)
GEMINI_RPM_SMART=5
GEMINI_RPM_FAST=15
GEMINI_MAX_CONCURRENCY=2
GEMINI_MAX_RETRIES=6
LLM_TEMPERATURE=0.2
LLM_CACHE=true
LLM_CACHE_NAMESPACE=default
# Merge Data+Model agent calls into one per plan (fewer requests on the free tier)
AGENT_FUSION=false
# Web knowledge via Gemini Google Search grounding
SEARCH_GROUNDING=true

# Vertex AI instead of AI Studio (optional)
GEMINI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# ---- Pipeline ----
N_PLANS=3
MAX_REVISIONS=2
MAX_DEBUG_ATTEMPTS=3
EXEC_TIMEOUT_S=1800
CODEGEN_MODE=llm

# ---- Server ----
CORS_ORIGINS=["http://localhost:3000"]

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
