# Copy to backend/.env (or repo-root .env) and fill in what you use.

# ---- LLM backend ----
# One of: fake | openai | anthropic | gemini | groq | ollama | openai_compatible
# "fake" is a deterministic offline backend used for tests and demos (no API key needed).
LLM_PROVIDER=fake
# Leave empty to use the provider's default model (see backend/src/automl_agent/llm/factory.py).
LLM_MODEL=
# Only for ollama / openai_compatible (e.g. a vLLM server): http://localhost:8000/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.2

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Pipeline ----
N_PLANS=3
MAX_REVISIONS=2
MAX_DEBUG_ATTEMPTS=3
EXEC_TIMEOUT_S=600
# "llm": Operation Agent writes/edits code; "template": run the rendered template as-is.
CODEGEN_MODE=llm

# ---- Server ----
CORS_ORIGINS=["http://localhost:3000"]

# ---- Frontend (frontend/.env.local) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
